# Copy to .env. Never commit real credentials.
# 必须替换为强随机值（至少 32 字节），例如: openssl rand -hex 32
# 该占位值属于已公开的开发密钥，鉴权开启时应用会拒绝启动。
AGI_JWT_SECRET=replace-with-at-least-32-random-characters

AGI_LLM_API_URL=https://example.com/v1/chat/completions
AGI_LLM_API_KEY=replace-me
AGI_LLM_MODEL=your-chat-model

AGI_EMBEDDING_API_URL=https://example.com/v1/embeddings
AGI_EMBEDDING_API_KEY=replace-me
AGI_EMBEDDING_MODEL=your-embedding-model

# Optional web search provider.
AGI_SEARCH_API_KEY=

# Optional SQLite + Chroma + bounded SQLite graph retrieval profile.
# Install requirements-lightweight.txt, then explicitly rebuild existing chunks.
# Keep the directory private; it contains derived document data.
AGI_RAG_LIGHTWEIGHT=0
# AGI_RAG_INDEX_DIR=/opt/agi-saber/runtime/retrieval-v1

# Online RAG experiments are fail-closed by default.  Keep "disabled" unless
# real authenticated traffic, monitoring, and two distinct reviewers exist.
AGI_DEFAULT_TENANT_ID=default
AGI_ONLINE_TRAFFIC_PROVENANCE=disabled
AGI_EXPERIMENT_HMAC_SECRET=

# Legacy compatibility only. A self-reported 64-hex string can NEVER satisfy
# the production_authenticated gate by itself; use the verified manifest below.
AGI_EXPERIMENT_RUNTIME_ENVIRONMENT_FINGERPRINT=

# Immutable runtime component evidence. Generate the manifest after the image
# and versioned RAG index exist, using scripts/build_runtime_component_manifest.py.
# Mount it read-only (0444) outside /app/runtime and inject the raw-file digest
# through the deployment controller, not inside the same manifest file.
AGI_EXPERIMENT_COMPONENT_MANIFEST_PATH=/run/agi/component-manifest.json
AGI_EXPERIMENT_COMPONENT_MANIFEST_SHA256=

# Version labels aid operations; the SHA-256 values bind actual corpus/index
# publication artifacts and must come from the indexing pipeline.
AGI_RAG_CORPUS_VERSION=
AGI_RAG_CORPUS_SHA256=
AGI_RAG_INDEX_VERSION=
AGI_RAG_INDEX_SHA256=

# Immutable application provenance supplied by CI/CD. Git SHA must be complete;
# image identity must use the sha256:<64-hex> form.
AGI_APPLICATION_BUILD_SHA=
AGI_GIT_COMMIT_SHA=
AGI_IMAGE_DIGEST=

# Comma-separated existing usernames.  The approver should be a different
# person from the experiment creator/administrator.
AGI_EXPERIMENT_ADMIN_USERNAMES=
AGI_EXPERIMENT_APPROVER_USERNAMES=

# production_authenticated automatically disables public registration.  Use
# scripts/provision_experiment_user.py to create/assign tenant accounts.
# Only explicitly eligible, operator-provisioned ordinary business accounts
# created before an experiment is submitted may contribute real exposure.

# Production evidence also requires the offline evaluation/proposal database
# to be shared by every service replica.  The operator provisions one database
# per derived tenant digest; the placeholder is mandatory for isolation.
# Example: postgresql+psycopg2://user:password@db/agi_eval_{tenant_digest}
AGI_EVAL_TENANT_DATABASE_URL_TEMPLATE=

# Optional only while upgrading a trusted, formerly single-tenant install.
# If omitted, legacy accounts remain isolated until the provisioning command
# explicitly assigns them to a tenant.
AGI_LEGACY_TENANT_ID=
